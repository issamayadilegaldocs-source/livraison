    "@types/jest": "~29.5.0",
    "babel-preset-expo": "~56.0.0",
    "babel-preset-react-native": "^5.0.2",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.22.1",
