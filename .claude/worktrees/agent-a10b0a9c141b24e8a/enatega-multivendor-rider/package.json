  "scripts": {
    "start": "expo start --port 8085",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android --port 8085",
    "android:device:clean": "npm run clean:metro && expo run:android --device --port 8085",
    "ios": "expo run:ios --port 8085",
    "ios:device:clean": "npm run clean:metro && expo run:ios --device --port 8085",
    "clean:metro": "npx kill-port 8085 || true",
    "web": "expo start --web --port 8085",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll --passWithNoTests",
    "lint": "npx eslint && prettier --write .",
    "upload-sourcemaps": "npx sentry-expo upload-sourcemaps"
  },
  "jest": {
    "preset": "jest-expo"
  },
