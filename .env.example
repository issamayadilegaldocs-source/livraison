# Adresse publique du site : sert aux miniatures des plats dans l'email (Gmail ne lit pas /media/...)
SITE_URL=https://livreur.hamma-delivery.com
# Optionnel : envoi WhatsApp automatique en plus (CallMeBot, gratuit, inscriptions parfois fermées).
# Sans clé, c'est le client qui envoie la commande sur WhatsApp depuis le site.
CALLMEBOT_APIKEY=
# Copie email des commandes (optionnel)
RESEND_API_KEY=
MAIL_FROM=Commandes <commandes@hamma-delivery.com>
# Images : base des URLs webp. Au déploiement, par défaut https://livreur.hamma-delivery.com/media.
# En local, après `npm run images -- <dump>/images public/media` : MEDIA_BASE_URL=/media
MEDIA_BASE_URL=
# Backend Supabase (optionnel : remplace R2 pour config, commandes, coupons, push et bons).
# En local avec `npm run local`, mettre SUPABASE_URL + SUPABASE_SECRET_KEY dans `.dev.vars`.
# Utiliser la clé secrète (`sb_secret_…`) côté serveur uniquement — jamais la clé publique (`sb_publishable_…`).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
